LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# 仅启用受信任的、兼容 OpenAI Chat Completions 的 HTTPS 服务

# Optional: use 8001 when 8000 is occupied. Existing .env is never overwritten.
BACKEND_PORT=8000
